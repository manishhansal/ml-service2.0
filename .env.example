# ────────────────────────────────────────────────────────────────────────────
# ml-service2.0 Environment Configuration
# Copy this file to .env and fill in the values for your environment.
# All variables without defaults are REQUIRED in production.
# ────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
# Port the service listens on (default: 8100)
PORT=8100

# Minimum structlog log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Controls heuristic fallback and live-trading eligibility
# RESEARCH | PAPER | SHADOW | VALIDATED_ML_ONLY
DEPLOYMENT_MODE=research

# Comma-separated list of CORS allowed origins for alpha-forge
ALLOWED_ORIGINS=http://localhost:3000

# ── Authentication ────────────────────────────────────────────────────────────
# API key required in X-API-KEY header for all prediction endpoints
ML_SERVICE_API_KEY=your-ml-service-api-key-here

# ── Upstream: data-service2.0 ─────────────────────────────────────────────────
# Base URL for data-service2.0 (the sole market data authority)
DATA_SERVICE_2_URL=http://localhost:8200

# API key or JWT used to authenticate with data-service2.0
DATA_SERVICE_API_KEY=your-data-service-api-key-here

# ── Upstream: SentinelPulse ───────────────────────────────────────────────────
# Base URL for SentinelPulse NLP/news intelligence service
SENTINEL_PULSE_URL=http://localhost:3001

# API key for SentinelPulse (required in production, can be empty for dev)
SENTINEL_PULSE_API_KEY=your-sentinel-pulse-api-key-here

# ── Storage: Redis ────────────────────────────────────────────────────────────
# Redis connection URL (feature cache TTL=60s, news cache TTL=90s)
REDIS_URL=redis://localhost:6379

# ── Storage: MLflow ───────────────────────────────────────────────────────────
# MLflow tracking server URI for experiment logging and model registry
MLFLOW_TRACKING_URI=http://localhost:5000

# ── Storage: Filesystem ───────────────────────────────────────────────────────
# Root path for model artifact storage (must be a persistent volume in production)
MODEL_ARTIFACTS_PATH=./artifacts

# Path to the append-only audit log (JSON Lines format)
AUDIT_LOG_PATH=./audit.jsonl

# ── Feature Pipeline ──────────────────────────────────────────────────────────
# TTL in seconds for feature vectors cached in Redis (default: 60, min: 10)
FEATURE_CACHE_TTL=60

# TTL in seconds for SentinelPulse news context in the LRU cache (default: 90, min: 10)
NEWS_CONTEXT_CACHE_TTL=90

# Minimum DataConfidenceScore from data-service2.0 (0–100).
# Responses below this threshold return INSUFFICIENT_EVIDENCE (default: 70)
MIN_CONFIDENCE_SCORE=70

# Set to true to enable Qlib Alpha360 360-dimensional factor computation (slower)
ALPHA360_ENABLED=false

# ── Training Pipeline ─────────────────────────────────────────────────────────
# Embargo period in trading days for purged K-fold CV (default: 10, min: 5)
EMBARGO_PERIOD_DAYS=10

# Minimum trading days a model must spend in SHADOW before LIVE promotion eligibility
SHADOW_TRADING_MIN_DAYS=20

# Number of Optuna HPO trials per model (default: 50, min: 50)
OPTUNA_N_TRIALS=50

# Number of overlapping test paths for CPCV (default: 10, min: 10)
CPCV_N_PATHS=10

# Minimum mean IC for the model acceptance gate (default: 0.02)
MODEL_ACCEPTANCE_MIN_IC=0.02

# Maximum backtest overfitting probability for the acceptance gate (default: 0.5)
MODEL_ACCEPTANCE_MAX_PBO=0.5

# ── Online Learning ───────────────────────────────────────────────────────────
# Set to true to enable incremental model updates on IC degradation
ONLINE_LEARNING_ENABLED=false

# Maximum consecutive incremental updates before a full retraining cycle is required
MAX_CONSECUTIVE_ONLINE_UPDATES=5

# IC degradation fraction from 90-day baseline that triggers online learning (default: 0.20)
ONLINE_LEARNING_IC_DEGRADATION_THRESHOLD=0.20

# ── gRPC ──────────────────────────────────────────────────────────────────────
# gRPC connection establishment timeout in seconds (default: 5.0)
GRPC_CONNECTION_TIMEOUT=5.0

# gRPC per-call deadline in seconds (default: 2.0)
GRPC_PER_CALL_DEADLINE=2.0

# Maximum reconnect attempts for an interrupted gRPC stream (default: 3)
GRPC_MAX_RECONNECT_ATTEMPTS=3

# ── LLM / Meta-Decision Engine ────────────────────────────────────────────────
# Maximum time in milliseconds for FinGPT/FinBERT LLM inference (default: 120, min: 50)
LLM_INFERENCE_TIMEOUT_MS=120

# HuggingFace model identifier for LLM news reasoning
# Default: ProsusAI/finbert | Alternative: THUDM/FinGPT-v3.3
LLM_MODEL_NAME=ProsusAI/finbert

# ── Promotion Gates ───────────────────────────────────────────────────────────
# Minimum IC improvement over champion required for the PREDICTIVE gate (0.001–0.05)
PREDICTIVE_GATE_MARGIN=0.005

# Number of hours before an approvalToken expires for human-approved promotions
APPROVAL_TOKEN_EXPIRY_HOURS=24

# ── Performance ───────────────────────────────────────────────────────────────
# Number of Uvicorn worker processes (default: 4, min: 1)
UVICORN_WORKERS=4
